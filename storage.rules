rules_version = '2';
service firebase.storage {
  // This rule matches ALL buckets in your project
  match /b/{bucket}/o {

    // Rule for video UPLOADS
    // Allows any authenticated user to write to the videos folder.
    match /contents/videos/{videoId} {
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024 // 20MB limit
                   && request.resource.contentType.matches('video/.*');

      // Allows a user to delete a video if their UID is stored in the file's metadata.
      allow delete: if request.auth != null && resource.metadata.uploaderId == request.auth.uid;
    }

    // Rule for thumbnail UPLOADS
    // Allows any authenticated user to write image files for thumbnails.
    match /contents/thumbnails/{thumbnailId} {
       allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024 // Optional: Max 5MB
                    && request.resource.contentType.matches('image/.*');
    }

    // Rules for avatars
    match /avatars/{userId} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Rules for community attachments
    match /community/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/.*') || request.resource.contentType.matches('text/.*'));
      allow read: if true;
    }

    // Rule for site assets (favicon, homepage background, etc.)
    match /site/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid != null
                   && request.resource.size < 10 * 1024 * 1024;
      allow read: if true;
    }

    // Rule for certificate backgrounds (templates uploaded by admin)
    match /certificate-backgrounds/{fileName} {
      allow write: if request.auth != null && request.auth.uid != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Rule for user-generated certificate PDFs
    match /certificates/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf');
      allow read: if request.auth != null
                  && (request.auth.uid == userId
                      || request.auth.token.role == 'admin'
                      || request.auth.token.role == 'developer');
    }

    // Rule for transcoded video PLAYBACK
    // This makes the final, processed videos public for anyone to stream.
    match /transcoded-videos/{allPaths=**} {
      allow read: if true;
    }

  }
}