rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Videos
    match /contents/videos/{videoFile=**} {
      allow read: if true; // allow anyone to stream/download videos
      allow write: if request.auth != null 
                   && request.resource.size < 200 * 1024 * 1024; // max 200MB per video
    }

    // Block anything else in this bucket
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
